# ============================================================
# Weather Station V2 - Environment
# Copy this file to `.env` and adjust the values.
# ============================================================

# ---------- InfluxDB (2.7) ----------
# Credentials used by the InfluxDB container during first-time setup.
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=change-me-please
INFLUXDB_ORG=weather
INFLUXDB_BUCKET=weather
# Admin token used by both InfluxDB setup and the web app.
INFLUXDB_TOKEN=weather-super-secret-token-change-me

# ---------- Web app (Next.js) ----------
# Internal URL (inside docker network) used by the web container.
# For local `npm run dev` use http://localhost:8086
INFLUX_URL=http://influxdb:8086

# Single API key expected in the `X-API-KEY` header of POST /api/weather.
WEATHER_API_KEY=my-super-secret-api-key

# Password for the /admin area (session cookie).
ADMIN_PASSWORD=admin123

# Dashboard polling interval in milliseconds.
NEXT_PUBLIC_POLL_INTERVAL=10000

# A device is considered "online" if it reported within this many ms (default 5 min).
ONLINE_THRESHOLD_MS=300000

# ---------- Agent (Raspberry Pi) ----------
# Inside docker compose use http://web:3000/api/weather
# From a real Raspberry Pi use http://<server-ip>:3000/api/weather
API_URL=http://web:3000/api/weather
API_KEY=my-super-secret-api-key
DEVICE=REMOTE-STATION-01
SITE=RemoteTestSite
INTERVAL=10
